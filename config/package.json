{
  "name": "servicedispatch",
  "version": "1.0.0",
  "description": "Enterprise Service Management Platform - Intelligent dispatch, real-time tracking, actionable analytics",
  "author": "ServiceDispatch Team <engineering@servicedispatch.example.com>",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/organization/servicedispatch.git"
  },
  "homepage": "https://servicedispatch.example.com",
  "bugs": {
    "url": "https://github.com/organization/servicedispatch/issues"
  },
  "keywords": [
    "service-dispatch",
    "field-service",
    "technician-management",
    "ticket-system",
    "enterprise",
    "flask",
    "python"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "main": "static/js/core.js",
  "scripts": {
    "dev": "concurrently \"npm:watch:*\"",
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass static/scss:static/css --style=compressed --source-map",
    "build:js": "esbuild static/js/src/*.js --bundle --minify --sourcemap --outdir=static/js/dist",
    "watch:css": "sass static/scss:static/css --watch --style=expanded --source-map",
    "watch:js": "esbuild static/js/src/*.js --bundle --watch --sourcemap --outdir=static/js/dist",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint static/js/src/**/*.js --fix",
    "lint:css": "stylelint static/scss/**/*.scss --fix",
    "format": "prettier --write \"static/**/*.{js,scss,css,json}\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "docs:serve": "bundle exec jekyll serve --livereload --incremental",
    "docs:build": "JEKYLL_ENV=production bundle exec jekyll build",
    "search:index": "node scripts/build-search-index.js",
    "clean": "rimraf static/css static/js/dist _site .sass-cache",
    "prepare": "husky install",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@playwright/test": "^1.41.2",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cssnano": "^6.1.0",
    "esbuild": "^0.20.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "sass": "^1.71.1",
    "stylelint": "^16.2.1",
    "stylelint-config-standard-scss": "^13.0.0"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ],
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "static/js/src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2024": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:import/recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": [
        "warn",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "prefer-const": "error",
      "no-var": "error",
      "eqeqeq": [
        "error",
        "always"
      ],
      "curly": "error"
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard-scss"
    ],
    "rules": {
      "selector-class-pattern": null,
      "scss/at-extend-no-missing-placeholder": null,
      "no-descending-specificity": null
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always"
  }
}
