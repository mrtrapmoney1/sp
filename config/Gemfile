# frozen_string_literal: true

source "https://rubygems.org"

# ServiceDispatch Documentation Site
# Ruby version requirement
ruby ">= 3.1.0"

# Jekyll core - Static site generator
gem "jekyll", "~> 4.3.3"

# GitHub Pages compatibility (optional - for deployment)
# gem "github-pages", group: :jekyll_plugins

# Theme - Minimal Mistakes for professional documentation
gem "minimal-mistakes-jekyll", "~> 4.26"

# Jekyll Plugins
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"           # RSS/Atom feed generation
  gem "jekyll-seo-tag", "~> 2.8"         # SEO meta tags
  gem "jekyll-sitemap", "~> 1.4"         # XML sitemap generation
  gem "jekyll-paginate-v2", "~> 3.0"     # Advanced pagination
  gem "jekyll-include-cache", "~> 0.2"   # Include caching for performance
  gem "jekyll-archives", "~> 2.2"        # Archive pages
  gem "jekyll-redirect-from", "~> 0.16"  # URL redirects
  gem "jekyll-relative-links", "~> 0.7"  # Relative link conversion
  gem "jekyll-default-layout", "~> 0.1"  # Default layouts
  gem "jekyll-titles-from-headings", "~> 0.5"  # Auto-generate titles
  gem "jemoji", "~> 0.13"                # GitHub emoji support
end

# Development dependencies
group :development do
  gem "webrick", "~> 1.8"               # Ruby web server (required for Ruby 3+)
  gem "rouge", "~> 4.2"                 # Syntax highlighting
  gem "kramdown-parser-gfm", "~> 1.1"   # GitHub Flavored Markdown
end

# Performance
gem "liquid-c", "~> 4.0"                # C extension for Liquid (faster templates)

# Windows-specific dependencies
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
  gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw, :mswin]
end

# Lock to specific HTTP parser for compatibility
gem "http_parser.rb", "~> 0.6.0", platforms: [:jruby]
