# ServiceDispatch Environment Configuration
# Copy this file to .env and customize for your environment

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/servicedispatch

# For SQLite (development only)
# DATABASE_URL=sqlite:///servicedispatch.db

# ServicePower API Credentials (optional - can be entered at login)
# SERVICEPOWER_USER=
# SERVICEPOWER_PASSWORD=
# SERVICEPOWER_ACCOUNT=
# SERVICEPOWER_ENV=production_na

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=servicepower_debug.log

# Server Configuration
HOST=127.0.0.1
PORT=5000
